# Copiá este archivo a .env y completá con los mismos valores que usa
# sofia-clase2-react (mismo backend real: Apps Script + Retell).

VITE_APPS_SCRIPT_URL=
VITE_APPS_SCRIPT_TOKEN=

VITE_RETELL_PUBLIC_KEY=
VITE_RETELL_AGENT_ID=

# ────────────────────────────────────────────────────────────────────────
# SERVER-ONLY, a propósito SIN prefijo VITE_ — solo la lee
# api/confirmar-pedido.js (función serverless de Vercel), nunca el
# navegador. Es el MISMO VALOR que ya pusiste arriba en
# VITE_APPS_SCRIPT_TOKEN (y el mismo que la Script Property
# APPS_SCRIPT_TOKEN de tu Apps Script) — se repite acá sin el prefijo
# VITE_ para que Vite no lo empaquete en el bundle del cliente.
# ────────────────────────────────────────────────────────────────────────
APPS_SCRIPT_TOKEN=
